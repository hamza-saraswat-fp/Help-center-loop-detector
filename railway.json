{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "src/**",
      "prompts/**",
      "config/**",
      "package.json",
      "package-lock.json",
      "Dockerfile"
    ]
  },
  "deploy": {
    "cronSchedule": "0 * * * *",
    "startCommand": "npm start",
    "restartPolicyType": "NEVER"
  }
}
