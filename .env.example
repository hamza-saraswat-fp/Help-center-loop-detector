# -- Required (hard-fail if missing) --

# Supabase project URL for the loop DB (prompts, gap_events, gap_candidates, ...).
SUPABASE_URL=
# Supabase service-role key; the loop DB is written with elevated privileges.
SUPABASE_SERVICE_ROLE_KEY=
# OpenRouter API key for model calls (usage: { include: true }, model comes from the prompts table).
OPENROUTER_API_KEY=
# Slack bot token used to post candidate cards and poll reactions.
SLACK_BOT_TOKEN=
# Slack channel ID that live-mode gap candidate cards post to.
SLACK_GAPS_CHANNEL_ID=
# Git remote URL for the help-docs repo that gets sparse-cloned locally.
DOCS_REPO_URL=

# -- Mode ladders (unknown values silently degrade to the default) --

# dry_run (default, writes/posts nothing) | shadow | live.
HC_LOOP_MODE=
# off (default) | shadow | live — Onyx corroboration ladder.
ONYX_MODE=

# -- Source databases (each optional; a source with no URL is skipped) --

# Juju bot's Postgres connection string (reads hc_gap_events_v only).
SOURCE_JUJU_PG_URL=
# Sidecar's Postgres connection string (reads hc_gap_events_v only).
SOURCE_SIDECAR_PG_URL=
# Ava's Postgres connection string (reads hc_gap_events_v only).
SOURCE_AVA_PG_URL=
# Email pipeline's Postgres connection string (reads hc_gap_events_v only).
SOURCE_EMAIL_PG_URL=
# Optional CA bundle for source Postgres TLS; unset falls back to rejectUnauthorized: false.
SOURCE_PG_SSL_CA=

# -- Slack routing --

# Channel ID that shadow-mode runs post to; unset means shadow runs stay silent.
SLACK_SHADOW_CHANNEL_ID=
# Comma-separated Slack user IDs to @-mention on candidate cards. Default: none.
SLACK_TAG_USER_IDS=
# Comma-separated Slack user IDs allowed to action a card via reaction. Default: same as SLACK_TAG_USER_IDS, or any human if both are unset.
SLACK_REACTION_USER_IDS=
# true to @-mention category owners on "needs answer" cards. Default: false.
HC_LOOP_OWNER_MENTIONS=

# -- Docs search --

# Mintlify MCP endpoint used as a second-opinion search. Default: https://fieldpulse.mintlify.app/mcp.
MINTLIFY_MCP_URL=

# -- Onyx (internal knowledge corroboration) --

# Base URL of the Onyx deployment; unset disables the lane entirely.
ONYX_BASE_URL=
# Onyx personal access token.
ONYX_API_KEY=
# Onyx persona ID scoped to the loop's retrieval set. Default: 1.
ONYX_PERSONA_ID=
# Per-run Onyx round-trip deadline in ms. Default: 15000.
ONYX_TIMEOUT_MS=

# -- Docs repo --

# Local directory the docs repo is sparse-cloned into. Default: /tmp/hc-docs.
DOCS_CLONE_DIR=
# owner/repo slug used for GitHub API calls (e.g. polling PRs). Default: Flicent/fieldpulse-help-docs.
DOCS_REPO_SLUG=
# GitHub token with repo access, used for cloning and PR polling/opening.
GITHUB_TOKEN=

# -- Run tuning --

# Max number of events given a full model-backed check per run. Default: 40.
HC_LOOP_MAX_CHECKS_PER_RUN=
# How many days back a "repull" re-checks already-seen events. Default: 14.
HC_LOOP_REPULL_DAYS=
# true to allow the run to open preview PRs against the docs repo (Option B seam). Default: false.
HC_LOOP_OPEN_PRS=

# -- Tooling (not read by the service) --

# Direct Postgres URL for the loop project, used only by `npm run migrate`
# (scripts/apply-migrations.sh). The service itself talks to Supabase over the
# REST URL above and never opens a Postgres connection to its own database.
DATABASE_URL=
